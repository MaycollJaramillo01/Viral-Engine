# Claude Code Imagen variante: instala el CLI de claude sobre la imagen oficial publicada.
#
# Claude Las suscripciones (Pro / Max / Team) no emiten API Keys; solo el cliente oficial de Claude Code
# puede usar las credenciales de suscripción, por lo que el Provider `claude_code` depende de que exista dentro del contenedor el ejecutable claude
# CLI. Aquí se reutiliza la imagen publicada para no reinstalar las dependencias de Python.
FROM ghcr.io/harry0703/moneyprinterturbo:latest

# CLI Versión fijada para evitar cambios de comportamiento al reconstruir la imagen; para actualizar, basta con cambiar aquí el número de versión.
ARG CLAUDE_CODE_VERSION=2.1.260
ARG NODE_MAJOR=22

# claude CLI Se distribuye por npm y la imagen publicada no incluye Node.js, así que primero hay que instalar el repositorio de NodeSource.
RUN set -eu; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -; \
    apt-get install -y --no-install-recommends nodejs; \
    npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"; \
    npm cache clean --force; \
    apt-get purge -y gnupg; \
    apt-get autoremove -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    claude --version
